flowchart BT
    %% Styling pour ressembler à des dossiers/paquets jaunes typiques
    classDef package fill:#fcdb73,stroke:#c49a1d,stroke-width:2px,color:#333,shape:rect,rx:3,ry:3;

    %% Nœuds centraux
    Auth["S'authentifier"]:::package
    
    %% Modules principaux dépendant de l'authentification
    Profil["Gérer profil"]:::package
    Transac["Gérer les transactions"]:::package
    Dash["Tableau de bord"]:::package
    Stats["Rapports et Statistiques"]:::package
    Notif["Notifications et Alertes"]:::package
    Admin["Espace Administrateur"]:::package
    IA["Assistant Vocal IA"]:::package
    
    %% Sous-modules - Authentification
    Inscrire["S'inscrire"]:::package
    Connecter["Se connecter"]:::package
    
    %% Sous-modules - Profil
    ModifInfos["Modifier infos perso"]:::package
    ModifMDP["Changer mot de passe"]:::package
    
    %% Sous-modules - Transactions
    AjoutDepense["Enregistrer dépense"]:::package
    AjoutRevenu["Enregistrer revenu"]:::package
    ModifTransac["Editer/Supprimer transaction"]:::package
    
    %% Sous-modules - IA
    CaptureAudio["Enregistrement Audio (Micro)"]:::package
    AnalyseIA["Extraction d'intention vocale"]:::package
    
    %% Sous-modules - Admin
    GestUsers["Gérer utilisateurs"]:::package
    GestCat["Gérer catégories"]:::package
    
    %% Sous-modules - Dashboard / Rapports
    Filtres["Filtrer les données"]:::package
    ExportPDF["Générer rapport PDF"]:::package
    
    %% Relations d'accès (Access) - allongées pour espacer horizontalement
    Profil -- "<<Access>>" ---> Auth
    Transac -- "<<Access>>" ---> Auth
    Dash -- "<<Access>>" ---> Auth
    Stats -- "<<Access>>" ---> Auth
    Notif -- "<<Access>>" ---> Auth
    Admin -- "<<Access>>" ---> Auth
    IA -- "<<Access>>" ---> Auth
    
    %% L'IA a besoin d'accéder aux transactions pour ajouter une dépense/revenu
    IA -- "<<Access>>" ---> Transac
    
    %% Dashboard et Stats ont besoin d'accéder aux transactions pour calculer
    Dash -- "<<Access>>" ---> Transac
    Stats -- "<<Access>>" ---> Transac
    
    %% Relations d'inclusion (Merge) - allongées pour espacer
    Inscrire -- "<<Merge>>" ---> Auth
    Connecter -- "<<Merge>>" ---> Auth
    
    ModifInfos -- "<<Merge>>" ---> Profil
    ModifMDP -- "<<Merge>>" ---> Profil
    
    AjoutDepense -- "<<Merge>>" ---> Transac
    AjoutRevenu -- "<<Merge>>" ---> Transac
    ModifTransac -- "<<Merge>>" ---> Transac
    
    CaptureAudio -- "<<Merge>>" ---> IA
    AnalyseIA -- "<<Merge>>" ---> IA
    
    GestUsers -- "<<Merge>>" ---> Admin
    GestCat -- "<<Merge>>" ---> Admin
    
    Filtres -- "<<Merge>>" ---> Dash
    ExportPDF -- "<<Merge>>" ---> Stats
