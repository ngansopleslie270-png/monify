# Gitignore – Monify Monorepo

# ── Node modules ──
node_modules/
**/node_modules/

# ── Variables d'environnement ──
.env
.env.local
.env.production
**/.env
**/.env.local

# ── Build frontend ──
frontend/dist/
frontend/.vite/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Divers ──
*.local
coverage/
.nyc_output/
